@{
    ViewBag.PageTitle = "Admin Area";
    ViewBag.CardTitle = "Dashboard";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<style>
    .fancy-box {
        background: linear-gradient(135deg, #3b82f6, #60a5fa);
        background-size: 400% 400%;
        border-radius: 18px;
        padding: 25px 20px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.12);
        position: relative;
        overflow: hidden;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        color: white !important;
        animation: gradientBG 15s ease infinite;
    }

    @@keyframes gradientBG {
        0%

    {
        background-position: 0% 50%;
    }

    50% {
        background-position: 100% 50%;
    }

    100% {
        background-position: 0% 50%;
    }

    }

    .fancy-box:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 45px rgba(0,0,0,0.25);
    }

    .fancy-box .inner h3 {
        font-size: 2.2rem;
        font-weight: 700;
        color: white;
        text-shadow: 1px 1px 8px rgba(0,0,0,0.3);
    }

    .fancy-box .icon {
        position: absolute;
        top: -10px;
        right: 15px;
        font-size: 60px;
        color: rgba(255,255,255,0.2);
        transition: transform 0.5s ease;
        animation: iconPop 1s ease forwards;
    }

    @@keyframes iconPop {
        0%

    {
        transform: scale(0.7);
    }

    100% {
        transform: scale(1);
    }

    }

    .fancy-box:hover .icon {
        transform: scale(1.15);
    }

    .fancy-box-footer {
        display: block;
        text-align: right;
        color: white;
        font-weight: 600;
        margin-top: 15px;
        text-decoration: none;
        transition: color 0.25s ease;
    }

        .fancy-box-footer:hover {
            color: #ffffffaa;
        }
</style>

<div class="row dashboard-row g-4">
    <div class="col-lg-3 col-md-6 col-12">
        <div class="fancy-box bg-info">
            <div class="inner">
                <h3 class="count" data-target="@ViewBag.Orders">0</h3>
                <p>All Orders</p>
            </div>
            <div class="icon">
                <i class="fas fa-shopping-bag"></i>
            </div>
            <a href="/Admin/Order/Index" class="fancy-box-footer">More info <i class="fas fa-arrow-circle-right"></i></a>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 col-12">
        <div class="fancy-box bg-success">
            <div class="inner">
                <h3 class="count" data-target="@ViewBag.ApprovedOrders">0</h3>
                <p>Approved Orders</p>
            </div>
            <div class="icon">
                <i class="fas fa-check-circle"></i>
            </div>
            <a href="/Admin/Order/Index" class="fancy-box-footer">More info <i class="fas fa-arrow-circle-right"></i></a>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 col-12">
        <div class="fancy-box bg-warning">
            <div class="inner">
                <h3 class="count" data-target="@ViewBag.Users">0</h3>
                <p>User Registrations</p>
            </div>
            <div class="icon">
                <i class="fas fa-user-plus"></i>
            </div>
            <a href="/Admin/Users/Index" class="fancy-box-footer">More info <i class="fas fa-arrow-circle-right"></i></a>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 col-12">
        <div class="fancy-box bg-danger">
            <div class="inner">
                <h3 class="count" data-target="@ViewBag.Products">0</h3>
                <p>Products</p>
            </div>
            <div class="icon">
                <i class="fas fa-box-open"></i>
            </div>
            <a href="/Admin/Product/Index" class="fancy-box-footer">More info <i class="fas fa-arrow-circle-right"></i></a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function animateValue(obj, start, end, duration) {
            let startTimestamp = null;
            const step = (timestamp) => {
                if (!startTimestamp) startTimestamp = timestamp;
                const progress = Math.min((timestamp - startTimestamp) / duration, 1);
                obj.innerText = Math.floor(progress * (end - start) + start);
                if (progress < 1) {
                    window.requestAnimationFrame(step);
                } else {
                    obj.innerText = end;
                }
            };
            window.requestAnimationFrame(step);
        }

        const counters = document.querySelectorAll('.count');
        counters.forEach(counter => {
            animateValue(counter, 0, +counter.getAttribute('data-target'), 2000);
        });
    </script>
}
