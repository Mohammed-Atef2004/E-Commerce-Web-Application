@page
@model LockoutModel
@{
    Layout = null;
    ViewData["Title"] = "Locked Out";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <style>
        body {
            margin: 0;
            padding: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #dfe9f3 0%, #ffffff 100%);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            animation: fadeIn 0.7s ease-in-out;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        .card {
            width: 430px;
            padding: 40px 30px;
            border-radius: 22px;
            background: rgba(255, 255, 255, 0.55);
            backdrop-filter: blur(15px);
            box-shadow: 0 10px 35px rgba(0, 0, 0, 0.15);
            text-align: center;
            animation: slideUp .6s ease-out;
        }

        @@keyframes slideUp {
            from {
                transform: translateY(20px);
                opacity: 0;
            }

            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        .icon {
            font-size: 4.5rem;
            color: #ff4b4b;
            margin-bottom: 15px;
        }

        h1 {
            font-size: 2rem;
            color: #222;
            margin-bottom: 10px;
        }

        p {
            color: #555;
            font-size: 1.1rem;
            margin-bottom: 25px;
        }

        .btn {
            display: inline-block;
            padding: 12px 26px;
            border-radius: 14px;
            background: linear-gradient(135deg, #2b8aff 0%, #005bea 100%);
            color: #fff;
            text-decoration: none;
            font-weight: 600;
            box-shadow: 0 5px 18px rgba(0, 91, 234, 0.25);
            transition: 0.3s;
        }

            .btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 22px rgba(0, 91, 234, 0.35);
            }

    </style>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>

<body>

    <div class="card">
        <i class="bi bi-lock-fill icon"></i>
        <h1>Locked Out</h1>
        <p>Your account has been locked due to multiple failed attempts.<br />Please try again later.</p>
        <a class="btn" asp-area="Customer" asp-controller="Home" asp-action="Index">Back to Home</a>
    </div>

</body>
</html>
